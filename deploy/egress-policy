#!/usr/bin/env python3
"""Render host nftables rules for the private Compose bridges."""
import argparse
import ipaddress
import socket


def ipv4(value):
    return str(ipaddress.IPv4Address(value))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--gateway", type=ipv4, help="Gateway IPv4 address reached by the desktop")
    parser.add_argument("--port", type=int, default=9000)
    parser.add_argument("--telegram", action="store_true", help="resolve the current Telegram API IPv4 addresses")
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("port must be 1..65535")
    addresses = []
    if args.telegram:
        addresses = sorted({ipv4(info[4][0]) for info in socket.getaddrinfo(
            "api.telegram.org", 443, socket.AF_INET, socket.SOCK_STREAM)})
        if not addresses:
            parser.error("Telegram API DNS resolution returned no IPv4 addresses")

    # The complete replacement is committed in one nft transaction.
    print("add table inet innervoice_egress")
    print("delete table inet innervoice_egress")
    print("table inet innervoice_egress {")
    for hook in ("input", "forward"):
        print(f" chain {hook} {{")
        print(f"  type filter hook {hook} priority -5; policy accept;")
        print('  iifname { "iv-gateway0", "iv-telegram0", "iv-desktop0" } ct state established,related accept')
        if args.gateway:
            print(f'  iifname "iv-desktop0" meta l4proto tcp ct original ip daddr {args.gateway} ct original proto-dst {args.port} accept')
        if addresses:
            print('  iifname "iv-telegram0" ip daddr { '+", ".join(addresses)+' } tcp dport 443 accept')
        print('  iifname { "iv-gateway0", "iv-telegram0", "iv-desktop0" } drop')
        print(" }")
    print("}")


if __name__ == "__main__":
    main()
