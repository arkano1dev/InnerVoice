#!/usr/bin/env bash
set -euo pipefail

action=${1:-help}
if [[ "$action" == help || "$action" == --help || "$action" == -h ]]; then
    cat <<'HELP'
InnerVoice desktop

  install     Guide first-time setup and add InnerVoice to your applications.
  open        Start the recorder if needed and show its editor.
  setup       Verify the gateway and save this workstation's settings.
  start       Start with the saved settings.
  update      Build the current desktop code and start it.
  power       Switch this client on or off. The gateway stays online.
  toggle      Start or finish a recording in the running client.
  show        Open the editor without starting the microphone.
  shortcut    Print the command for your global keyboard shortcut.
  check       Test TLS and authentication from the running container.
  storage     Show usage, configure the audio limit or clean older completed audio.
  status      Show the container state.
  logs        Follow recent client diagnostics.
  stop        Turn off the recorder and indicator.
HELP
    exit
fi
case "$action" in
    install|open|setup|start|update|power|toggle|show|shortcut|check|storage|status|logs|stop) ;;
    *) echo "Usage: $0 install|open|setup|start|update|power|toggle|show|shortcut|check|storage|status|logs|stop" >&2; exit 2 ;;
esac
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
if [[ "$action" == storage ]]; then
    shift
    exec python3 "$repo_dir/clients/recording_storage.py" "$@"
fi
if [[ "$action" == shortcut ]]; then
    printf '"%s/bin/innervoice-desktop" toggle\n' "$repo_dir"
    exit
fi
export IV_DESKTOP_UID=$(id -u)
export IV_DESKTOP_GID=$(id -g)
if [[ "$IV_DESKTOP_UID" == 0 || "$IV_DESKTOP_GID" == 0 ]]; then echo "Use your desktop account." >&2; exit 1; fi
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$IV_DESKTOP_UID}
display=${WAYLAND_DISPLAY:-wayland-0}
case "$display" in
    /*) export IV_DESKTOP_WAYLAND_SOCKET=$display ;;
    *) export IV_DESKTOP_WAYLAND_SOCKET=$runtime_dir/$display ;;
esac
export IV_DESKTOP_PULSE=$runtime_dir/pulse
export IV_DESKTOP_CONFIG=$HOME/.config/innervoice-desktop
export IV_DESKTOP_STATE=$HOME/.local/state/innervoice-desktop

if [[ "$action" == install ]]; then
    echo "InnerVoice for Ubuntu Wayland"
    echo "Requirements: Docker Compose, a Wayland session and PulseAudio or PipeWire-Pulse."
    echo "For the tray: install python3-pyqt5 and qtwayland5 and enable your desktop's AppIndicator extension."
    echo "See $repo_dir/INSTALL.md for Gateway credentials and Meshnet checks."
    if [[ ! -f "$IV_DESKTOP_CONFIG/settings.json" ]]; then
        "$repo_dir/bin/innervoice-desktop" setup
    fi
    "$repo_dir/bin/innervoice-desktop" start
    python3 "$repo_dir/clients/install_launcher.py"
    printf 'Open InnerVoice from Applications. Optional shortcut command:\n'
    "$repo_dir/bin/innervoice-desktop" shortcut
    exit
fi
if [[ "$action" == open ]]; then
    if "$repo_dir/bin/innervoice-desktop" show 2>/dev/null; then exit; fi
    if "$repo_dir/bin/innervoice-desktop" start; then
        for ((attempt=0; attempt<20; attempt++)); do
            if "$repo_dir/bin/innervoice-desktop" show 2>/dev/null; then exit; fi
            sleep 0.25
        done
    fi
    if command -v notify-send >/dev/null; then
        notify-send "InnerVoice" "Recorder unavailable. Run innervoice-desktop status and logs from the checkout." || true
    fi
    exit 1
fi

compose=(docker compose --env-file /dev/null -p innervoice-desktop -f "$repo_dir/compose.desktop.yml")
mode=${INNERVOICE_DESKTOP_HOST_NETWORK:-}
if [[ -z "$mode" && -f "$IV_DESKTOP_CONFIG/network-mode" ]]; then
    read -r mode < "$IV_DESKTOP_CONFIG/network-mode"
fi
case "${mode:=0}" in 0|1) ;; *) echo "Network mode must be 0 (bridge) or 1 (host)." >&2; exit 2 ;; esac
if [[ "$mode" == 1 ]]; then
    compose+=(-f "$repo_dir/compose.desktop.host-network.yml")
fi
if [[ "$action" == power ]]; then
    running=$("${compose[@]}" ps --status running -q desktop)
    if [[ -n "$running" ]]; then action=stop; else action=start; fi
fi
if [[ "$action" == setup || "$action" == start || "$action" == update ]]; then
    if [[ "${XDG_SESSION_TYPE:-}" != wayland || ! -S "$IV_DESKTOP_WAYLAND_SOCKET" ]]; then
        echo "Run this from your local Wayland desktop session. Display socket: $IV_DESKTOP_WAYLAND_SOCKET" >&2
        exit 1
    fi
    if [[ ! -S "$IV_DESKTOP_PULSE/native" ]]; then
        echo "PulseAudio or PipeWire-Pulse socket missing: $IV_DESKTOP_PULSE/native" >&2
        exit 1
    fi
    install -d -m 700 "$IV_DESKTOP_CONFIG" "$IV_DESKTOP_STATE"
    if [[ "$action" == setup ]]; then
        printf 'Desktop network: %s (1 uses the workstation network, 0 uses Docker bridge).\n' "$mode"
        echo "For direct Meshnet, leave traffic routing off. If only Docker times out, see INSTALL.md."
        "${compose[@]}" run --rm --volume "$IV_DESKTOP_CONFIG:/home/innervoice/.config/innervoice-desktop:rw" desktop setup
        umask 077
        temp_mode=$(mktemp "$IV_DESKTOP_CONFIG/.network-mode.XXXXXX")
        printf '%s\n' "$mode" > "$temp_mode"
        mv "$temp_mode" "$IV_DESKTOP_CONFIG/network-mode"
        exit
    fi
    if [[ ! -f "$IV_DESKTOP_CONFIG/settings.json" ]]; then
        echo "Run $0 setup before starting the desktop client." >&2
        exit 1
    fi
    if [[ "$action" == update ]]; then
        "${compose[@]}" build desktop
    fi
    # Compose builds a missing image and otherwise reuses the local one.
    if output=$("${compose[@]}" up -d desktop 2>&1); then
        printf '%s\n' "$output"
    else
        status=$?
        printf '%s\n' "$output" >&2
        stale='container ([0-9a-f]{12,64}) is not connected to the network innervoice-desktop_default([[:space:]]|$)'
        [[ "$output" =~ $stale ]] || exit "$status"
        container=${BASH_REMATCH[1]}
        format='{{index .Config.Labels "com.docker.compose.project"}} {{index .Config.Labels "com.docker.compose.service"}} {{index .Config.Labels "com.docker.compose.oneoff"}} {{.State.Status}}'
        owner=$(docker inspect --type container --format "$format" "$container")
        case "${owner,,}" in
            "innervoice-desktop desktop false exited"|"innervoice-desktop desktop false created")
                docker rm "$container" ;;
            *) exit "$status" ;;
        esac
        "${compose[@]}" up -d desktop
    fi
    if /usr/bin/python3 -c 'from PyQt5.QtWidgets import QSystemTrayIcon' 2>/dev/null; then
        if ! systemctl --user is-active --quiet innervoice-indicator.service; then
            systemd-run --user --collect --unit=innervoice-indicator --setenv=QT_QPA_PLATFORM=wayland --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" /usr/bin/python3 "$repo_dir/clients/tray.py" || echo "Panel indicator unavailable. The recorder overlay remains accessible."
        fi
    else
        echo "For the panel indicator install python3-pyqt5 and qtwayland5 and enable your desktop's AppIndicator tray."
    fi
    exit
fi

case "$action" in
    toggle|show) exec "${compose[@]}" exec -T desktop /opt/innervoice/bin/python /app/desktop.py "$action" ;;
    check) exec "${compose[@]}" exec -T desktop /opt/innervoice/bin/python /app/desktop.py check ;;
    status) exec "${compose[@]}" ps -a desktop ;;
    logs) exec "${compose[@]}" logs -f --tail=80 desktop ;;
    stop) systemctl --user stop innervoice-indicator.service 2>/dev/null || true
          exec "${compose[@]}" stop desktop ;;
esac
