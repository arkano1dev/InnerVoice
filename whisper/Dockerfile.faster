# The operator provisions a ROCm CTranslate2 base compatible with the deployment device.
ARG CT2_ROCM_IMAGE
FROM ${CT2_ROCM_IMAGE}
RUN python -c "import torch, ctranslate2; assert ctranslate2.__version__ == '4.9.0'; print('ctranslate2==' + ctranslate2.__version__)" > /tmp/ct2-constraint.txt && \
    pip install --no-cache-dir -c /tmp/ct2-constraint.txt faster-whisper==1.2.1 Flask==3.1.3 gunicorn==23.0.0
WORKDIR /app
COPY whisper_server.py .
CMD ["gunicorn","--bind","0.0.0.0:9000","--workers","1","--threads","4","--timeout","600","whisper_server:app"]
