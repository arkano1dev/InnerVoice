FROM cgr.dev/chainguard/wolfi-base AS runtime
RUN apk add --no-cache ca-certificates python-3.13 portaudio libpulse libglvnd \
    libxkbcommon wayland-libs-client wayland-libs-cursor wayland-libs-egl \
    libfontconfig1 fontconfig-config ttf-dejavu glib libstdc++ \
    so:libzstd.so.1 so:libdbus-1.so.3 so:libEGL.so.1 so:libGL.so.1
ENV PATH=/opt/innervoice/bin:$PATH IV_DESKTOP_QT=6 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

FROM runtime AS build
RUN apk add --no-cache py3.13-pip build-base pkgconf file alsa-lib-dev pulseaudio-dev curl bzip2
# Build the Pulse adapter only. PortAudio continues to use the default ALSA device.
RUN curl -fsSL --retry 3 https://www.alsa-project.org/files/pub/plugins/alsa-plugins-1.2.12.tar.bz2 -o /tmp/plugins.tar.bz2 && \
    echo 'b2064eb32662662f422f6e7c71f503d82c68d7a7059c8197bdd61ee08735b3ee104c6a5f9e3451e81124634514b91fc89d05d33041d9c2bb0f55b3c2ac3271b1  /tmp/plugins.tar.bz2' | sha512sum -c - && \
    tar -xjf /tmp/plugins.tar.bz2 -C /tmp && cd /tmp/alsa-plugins-1.2.12 && \
    ./configure --prefix=/usr && make -C pulse && mkdir /pulse && cp pulse/.libs/*_pulse.so /pulse/
RUN python3.13 -m venv --without-pip /opt/innervoice && \
    /usr/bin/python3.13 -m pip --python /opt/innervoice install --no-cache-dir --only-binary=:all: \
        PySide6-Essentials==6.12.0 requests==2.34.2 sounddevice==0.5.6

FROM runtime
COPY --from=build /opt/innervoice /opt/innervoice
COPY --from=build /pulse/ /usr/lib/alsa-lib/
RUN printf 'pcm.!default { type pulse }\nctl.!default { type pulse }\n' > /etc/asound.conf
RUN python -c "from PySide6.QtWidgets import QApplication; import sounddevice" || { \
    qt=$(python -c "import sysconfig; print(sysconfig.get_path('purelib'))")/PySide6/Qt; \
    for lib in "$qt"/lib/libQt6Core.so.6 "$qt"/lib/libQt6Gui.so.6 "$qt"/lib/libQt6Widgets.so.6 "$qt"/lib/libQt6WaylandClient.so.6 "$qt"/plugins/platforms/*wayland*.so; do ldd "$lib" || true; done; exit 1; }
ENV HOME=/home/innervoice
COPY desktop.py provider.py recording_storage.py ./
USER 65534:65534
ENTRYPOINT ["/opt/innervoice/bin/python", "/app/desktop.py"]
CMD ["run"]
